static std::wstring GetStr(PCWSTR name, PCWSTR def) {
    PCWSTR s = Wh_GetStringSetting(name);
    std::wstring r = (s && *s) ? s : def;
    if (s) Wh_FreeStringSetting(s);
    return r;
}

