static Layout DefaultLayout(int style, int preset = 0) {
    style = Clampi(style, 0, kStyleCount - 1);
    MONITORINFO mi = {sizeof(mi)};
    HMONITOR m = MonitorFromPoint(POINT{0, 0}, MONITOR_DEFAULTTOPRIMARY);
    GetMonitorInfoW(m, &mi);
    Layout L;
    L.style = style;
    for (int s = 0; s < kStyleCount; s++) L.color[s][0] = L.color[s][1] = 0;  // 0 = default color
    L.w = kStyleDefW[style];
    L.h = kStyleDefH[style];
    L.preset = Clampi(preset, 0, kCustomPresetCount - 1);
    L.cweight = 0;
    L.font[0][0] = L.font[1][0] = 0;
    if (style == STYLE_CUSTOM) {
        L.w = kPresets[L.preset].w;
        L.h = kPresets[L.preset].h;
    }
    L.x = mi.rcWork.left + ((mi.rcWork.right - mi.rcWork.left) - L.w) / 2;
    L.y = mi.rcWork.top + (mi.rcWork.bottom - mi.rcWork.top) / 6;
    return L;
}

static void ClampLayoutToScreen(Layout& L) {
    L.w = Clampi(L.w, kMinW, kMaxW);
    L.h = Clampi(L.h, kMinH, kMaxH);
    L.style = Clampi(L.style, 0, kStyleCount - 1);
    RECT r = {L.x, L.y, L.x + L.w, L.y + L.h};
    if (!MonitorFromRect(&r, MONITOR_DEFAULTTONULL)) {
        // Completely off-screen (monitor removed?) -> bring back to the primary monitor
        MONITORINFO mi = {sizeof(mi)};
        HMONITOR m = MonitorFromPoint(POINT{0, 0}, MONITOR_DEFAULTTOPRIMARY);
        GetMonitorInfoW(m, &mi);
        L.x = mi.rcWork.left + ((mi.rcWork.right - mi.rcWork.left) - L.w) / 2;
        L.y = mi.rcWork.top + (mi.rcWork.bottom - mi.rcWork.top) / 6;
    }
}

static const wchar_t kDefaultKey[] = L"default_layout";

// The saved default clock (position, size, style, colors), if there is one.
static bool LoadDefaultLayout(Layout* L) {
    if (!LoadProfile(kDefaultKey, L)) return false;
    ClampLayoutToScreen(*L);
    return true;
}

static EdGeom ComputeEdGeom(const Layout& L) {
    EdGeom g;
    g.w = std::max(L.w + 2 * kMargin, kHintMinW);
    g.ox = (g.w - L.w) / 2;
    g.h = L.h + 2 * kMargin + kHintH;

    RECT r = {L.x, L.y, L.x + L.w, L.y + L.h};
    HMONITOR mon = MonitorFromRect(&r, MONITOR_DEFAULTTONEAREST);
    MONITORINFO mi = {sizeof(mi)};
    GetMonitorInfoW(mon, &mi);
    g.hintAbove = (L.y + L.h + kMargin + kHintH > mi.rcMonitor.bottom);
    g.oy = kMargin + (g.hintAbove ? kHintH : 0);
    g.x = L.x - g.ox;
    g.y = L.y - g.oy;
    return g;
}

