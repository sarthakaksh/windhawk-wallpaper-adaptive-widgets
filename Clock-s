    g_settings.techTextFont = GetStr(L"techTextFont", L"Segoe UI");
    g_settings.boldFont = GetStr(L"boldFont", L"Segoe UI");
    g_settings.techBigFont = GetStr(L"techBigFont", L"Electroharmonix");
    g_settings.customFont = GetStr(L"customFont", L"");
    g_settings.customFont2 = GetStr(L"customFont2", L"");
    g_settings.stackFont = GetStr(L"stackFont", L"Impact");
    g_settings.scriptDayFont = GetStr(L"scriptDayFont", L"Segoe Script");
    g_settings.scriptTimeFont = GetStr(L"scriptTimeFont", L"Bahnschrift");
    g_settings.scriptDateFont = GetStr(L"scriptDateFont", L"Bahnschrift");
    g_settings.scriptOpacity = Clampi(Wh_GetIntSetting(L"scriptOpacity"), 0, 100);
    g_settings.wallDelay = Clampi(Wh_GetIntSetting(L"wallpaperDelayMs"), 0, 5000);
    g_settings.defHotkey = GetStr(L"defaultHotkey", L"Ctrl+Alt+Shift+D");
    g_settings.sameForAll = Wh_GetIntSetting(L"sameForAll") != 0;
    auto hex = [](const std::wstring& s, float& r, float& g, float& b) {
        const wchar_t* p = s.c_str();
        if (*p == L'#') p++;
        unsigned long v = wcstoul(p, nullptr, 16);
        r = ((v >> 16) & 255) / 255.0f;
        g = ((v >> 8) & 255) / 255.0f;
        b = (v & 255) / 255.0f;
    };
    hex(GetStr(L"posterNumberColor", L"2F6DB5"), g_settings.nr, g_settings.ng, g_settings.nb);
    hex(GetStr(L"posterTextColor", L"FF9A3C"), g_settings.ar, g_settings.ag, g_settings.ab);
    for (int st = 0; st < kStyleCount; st++) {
        for (int j = 0; j < kStyleColorCount[st]; j++) {
            std::wstring cs = GetStr(kStyleColorSetting[st][j], L"");
            const wchar_t* cp = cs.c_str();
            if (*cp == L'#') cp++;
            g_settings.defColor[st][j] =
                *cp ? (unsigned)(wcstoul(cp, nullptr, 16) & 0xFFFFFFu) : kStyleColorFallback[st][j];
        }
    }
    hex(GetStr(L"boldTextColor", L"FFFFFF"), g_settings.br, g_settings.bg, g_settings.bb);
    g_settings.fontName = GetStr(L"fontName", L"Segoe UI");
    g_settings.hotkey = GetStr(L"editHotkey", L"Ctrl+Alt+Shift+C");
    g_settings.placement = GetStr(L"placement", L"aboveIcons");

    std::wstring col = GetStr(L"textColor", L"FFFFFF");
    const wchar_t* p = col.c_str();
    if (*p == L'#') p++;
    unsigned long v = wcstoul(p, nullptr, 16);
    g_settings.r = ((v >> 16) & 255) / 255.0f;
    g_settings.g = ((v >> 8) & 255) / 255.0f;
    g_settings.b = (v & 255) / 255.0f;
}

static bool ParseHotkey(const std::wstring& s, UINT* mods, UINT* vk) {
    *mods = MOD_NOREPEAT;
    *vk = 0;
    size_t i = 0;
    while (i <= s.size()) {
        size_t j = s.find(L'+', i);
        if (j == std::wstring::npos) j = s.size();
        std::wstring tok = s.substr(i, j - i);
        i = j + 1;

        std::wstring t;
        for (wchar_t c : tok) {
            if (c == L' ') continue;
            if (c >= L'a' && c <= L'z') c = c - L'a' + L'A';
            t += c;
        }
        if (t.empty()) continue;

        if (t == L"CTRL" || t == L"CONTROL") *mods |= MOD_CONTROL;
        else if (t == L"ALT") *mods |= MOD_ALT;
        else if (t == L"SHIFT") *mods |= MOD_SHIFT;
        else if (t == L"WIN") *mods |= MOD_WIN;
        else if (t.size() == 1 && ((t[0] >= L'A' && t[0] <= L'Z') || (t[0] >= L'0' && t[0] <= L'9'))) *vk = t[0];
        else if (t[0] == L'F' && t.size() >= 2) {
            int n = (int)wcstol(t.c_str() + 1, nullptr, 10);
            if (n >= 1 && n <= 24) *vk = VK_F1 + (n - 1);
        }
    }
    return *vk != 0;
}

static void RegisterEditHotkey() {
    if (!g_ctrl) return;
    UnregisterHotKey(g_ctrl, HOTKEY_ID);
    UnregisterHotKey(g_ctrl, HOTKEY_DEFAULT_ID);
    UINT mods, vk;
    if (ParseHotkey(g_settings.hotkey, &mods, &vk)) {
        if (!RegisterHotKey(g_ctrl, HOTKEY_ID, mods, vk))
            Wh_Log(L"RegisterHotKey (editor) failed (%lu) - shortcut probably in use", GetLastError());
    } else {
        Wh_Log(L"Invalid editor hotkey: %s", g_settings.hotkey.c_str());
    }
    if (ParseHotkey(g_settings.defHotkey, &mods, &vk)) {
        if (!RegisterHotKey(g_ctrl, HOTKEY_DEFAULT_ID, mods, vk))
            Wh_Log(L"RegisterHotKey (default) failed (%lu) - shortcut probably in use", GetLastError());
    } else {
        Wh_Log(L"Invalid default-clock hotkey: %s", g_settings.defHotkey.c_str());
    }
}

