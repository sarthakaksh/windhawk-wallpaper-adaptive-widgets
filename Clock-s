static std::wstring Lower(std::wstring v) {
    for (auto& c : v) {
        if (c >= L'A' && c <= L'Z') c += 32;
    }
    return v;
}

static bool IsTranscoded(const std::wstring& path) {
    return Lower(path).find(L"transcodedwallpaper") != std::wstring::npos;
}

static std::wstring ReadRegString(HKEY root, PCWSTR sub, PCWSTR name) {
    std::wstring out;
    HKEY hk;
    if (RegOpenKeyExW(root, sub, 0, KEY_QUERY_VALUE, &hk) == ERROR_SUCCESS) {
        wchar_t buf[1024];
        DWORD sz = 2046, type = 0;
        if (RegQueryValueExW(hk, name, nullptr, &type, reinterpret_cast<BYTE*>(buf), &sz) == ERROR_SUCCESS &&
            (type == REG_SZ || type == REG_EXPAND_SZ)) {
            buf[sz / sizeof(wchar_t)] = 0;
            out = buf;
        }
        RegCloseKey(hk);
    }
    return out;
}

// Original image path that Windows keeps in a binary registry value (UTF-16 text after a 24-byte header).
static std::wstring ReadTranscodedCachePath() {
    HKEY hk;
    std::wstring out;
    if (RegOpenKeyExW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", 0, KEY_QUERY_VALUE, &hk) == ERROR_SUCCESS) {
        BYTE buf[2048];
        DWORD sz = sizeof(buf), type = 0;
        LONG r = RegQueryValueExW(hk, L"TranscodedImageCache", nullptr, &type, buf, &sz);
        RegCloseKey(hk);
        if (r == ERROR_SUCCESS && type == REG_BINARY && sz > 26) {
            const wchar_t* p = (const wchar_t*)(buf + 24);
            size_t maxChars = (sz - 24) / 2;
            size_t n = 0;
            while (n < maxChars && p[n]) n++;
            out.assign(p, n);
        }
    }
    return out;
}

// Fingerprint of the file Windows renders the current wallpaper into. It changes with every wallpaper
// change (slideshow, Spotlight, themes...) even when the registry paths do not. Cached by timestamp+size.
static std::wstring TranscodedFingerprint() {
    static FILETIME lastFt = {};
    static ULONGLONG lastSize = 0;
    static std::wstring lastFp;
    static bool have = false;

    wchar_t appdata[MAX_PATH];
    DWORD n = GetEnvironmentVariableW(L"APPDATA", appdata, MAX_PATH);
    if (!n || n >= MAX_PATH) return L"";
    std::wstring path = std::wstring(appdata) + L"\\Microsoft\\Windows\\Themes\\TranscodedWallpaper";

    WIN32_FILE_ATTRIBUTE_DATA fa;
    if (!GetFileAttributesExW(path.c_str(), GetFileExInfoStandard, &fa)) {
        have = false;
        lastFp.clear();
        return L"";
    }
    ULONGLONG size = ((ULONGLONG)fa.nFileSizeHigh << 32) | fa.nFileSizeLow;
    if (have && CompareFileTime(&fa.ftLastWriteTime, &lastFt) == 0 && size == lastSize) return lastFp;

    HANDLE h = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                           nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (h == INVALID_HANDLE_VALUE) return lastFp;  // being rewritten right now: keep the previous value

    unsigned long long hash = 1469598103934665603ULL ^ size;
    BYTE buf[4096];
    LONGLONG offs[3] = {0, (LONGLONG)(size / 2), (LONGLONG)(size > 4096 ? size - 4096 : 0)};
    for (int i = 0; i < 3; i++) {
        LARGE_INTEGER li;
        li.QuadPart = offs[i];
        DWORD got = 0;
        if (SetFilePointerEx(h, li, nullptr, FILE_BEGIN) && ReadFile(h, buf, sizeof(buf), &got, nullptr)) {
            for (DWORD k = 0; k < got; k++) {
                hash ^= buf[k];
                hash *= 1099511628211ULL;
            }
        }
    }
    CloseHandle(h);

    wchar_t out[48];
    wsprintfW(out, L"fp_%08x%08x", (UINT)(hash >> 32), (UINT)(hash & 0xFFFFFFFFULL));
    lastFp = out;
    lastFt = fa.ftLastWriteTime;
    lastSize = size;
    have = true;
    return lastFp;
}

// Identity of the current wallpaper. Uses the real image path(s) when Windows exposes them,
// otherwise (slideshow / Spotlight) a fingerprint of the rendered wallpaper file.
static std::wstring GetWallpaperId(std::wstring* dbg) {
    std::wstring a = ReadTranscodedCachePath();
    std::wstring b = ReadRegString(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"WallPaper");
    if (b.empty()) {
        wchar_t p[MAX_PATH] = {};
        if (SystemParametersInfoW(SPI_GETDESKWALLPAPER, MAX_PATH, p, 0)) b = p;
    }
    if (dbg) *dbg = L"cache=" + a + L" | wallpaper=" + b;

    std::wstring id;
    if (!a.empty() && !IsTranscoded(a)) id = Lower(a);
    if (!b.empty() && !IsTranscoded(b)) {
        if (!id.empty()) id += L"|";
        id += Lower(b);
    }
    if (id.empty()) {
        std::wstring fp = TranscodedFingerprint();
        id = fp.empty() ? L"(solid color)" : fp;
    }
    return id;
}

static std::wstring MakeKey(const std::wstring& path) {
    unsigned long long h = 1469598103934665603ULL;  // FNV-1a
    for (wchar_t c : path) {
        if (c >= L'A' && c <= L'Z') c += 32;
        h ^= (unsigned long long)c;
        h *= 1099511628211ULL;
    }
    wchar_t buf[48];
    wsprintfW(buf, L"wp_%08x%08x", (UINT)(h >> 32), (UINT)(h & 0xFFFFFFFFULL));
    return buf;
}

// Profile format: "x,y,w,h,style". Older profiles ("x,y,w,h") have no style and load as Classic.
static bool ParseLayout(const wchar_t* s, Layout* L) {
    long v[5] = {0, 0, 0, 0, 0};
    int count = 0;
    for (int i = 0; i < 5; i++) {
        wchar_t* e = nullptr;
        v[i] = wcstol(s, &e, 10);
        if (e == s) return false;
        count++;
        s = e;
        if (*s == L',') s++;
        else break;
    }
    if (count < 4) return false;
    L->x = v[0];
    L->y = v[1];
    L->w = v[2];
    L->h = v[3];
    L->style = (count >= 5) ? Clampi((int)v[4], 0, kStyleCount - 1) : 0;
    // then one hex color per style slot; missing / 0 = default color
    for (int st = 0; st < kStyleCount; st++) {
        for (int j = 0; j < 2; j++) {
            unsigned c = 0;
            if (*s && *s != L'|') {
                wchar_t* e = nullptr;
                c = wcstoul(s, &e, 16);
                if (e == s) {
                    c = 0;
                } else {
                    s = e;
                    if (*s == L',') s++;
                }
            }
            L->color[st][j] = (c & kColorSet) ? c : 0;
        }
    }

    // Custom style part: "|preset,weight|font1|font2"  (older profiles have none)
    L->preset = 0;
    L->cweight = 0;
    L->font[0][0] = L->font[1][0] = 0;
    if (*s == L'|') {
        s++;
        wchar_t* e = nullptr;
        long pv = wcstol(s, &e, 10);
        if (e != s) {
            L->preset = (int)pv;
            s = e;
            if (*s == L',') s++;
        }
        long wv = wcstol(s, &e, 10);
        if (e != s) {
            L->cweight = (int)wv;
            s = e;
        }
        for (int i = 0; i < 2; i++) {
            if (*s != L'|') break;
            s++;
            int n = 0;
            while (*s && *s != L'|' && n < 63) L->font[i][n++] = *s++;
            L->font[i][n] = 0;
            while (*s && *s != L'|') s++;
        }
    }
    L->preset = Clampi(L->preset, 0, kCustomPresetCount - 1);
    L->cweight = Clampi(L->cweight, 0, 3);
    return true;
}

static bool LoadProfile(const std::wstring& key, Layout* L) {
    wchar_t buf[512] = {};
    if (Wh_GetStringValue(key.c_str(), buf, 512) == 0) return false;
    return ParseLayout(buf, L);
}

static void SaveProfile(const std::wstring& key, const Layout& L) {
    if (key.empty()) return;
    wchar_t buf[512];
    int n = wsprintfW(buf, L"%d,%d,%d,%d,%d", L.x, L.y, L.w, L.h, L.style);
    for (int st = 0; st < kStyleCount && n < 300; st++) {
        for (int j = 0; j < 2 && n < 300; j++) n += wsprintfW(buf + n, L",%x", L.color[st][j]);
    }
    wsprintfW(buf + n, L"|%d,%d|%s|%s", L.preset, L.cweight, L.font[0], L.font[1]);
    Wh_SetStringValue(key.c_str(), buf);
}

