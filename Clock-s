struct CLine {
    const wchar_t* text;  // template
    float x, y;           // anchor in the box (0..1): x = left / center / right edge, y = middle of the capitals
    float cap;            // height of capitals / digits, as a fraction of the box HEIGHT
    int align;            // 0 = left, 1 = center, 2 = right
    int font;             // 0 = main font, 1 = small font
    int weight;           // 100..900 (400 regular, 700 bold, 900 black)
    float track;          // letter spacing in em (0.1 = a bit wider)
    float alpha;          // 0..1
    int color;            // 0 = Main color, 1 = Small color
    float maxW;           // text is squeezed to fit this fraction of the box width
    float fade;           // 1 = solid, 0.45 = fades to 45% at the bottom of the letters
    bool upper;           // force UPPER CASE
    bool isDate;          // hidden when "Show date" is off
};
struct CPreset {
    const wchar_t* name;
    int w, h;              // default box size
    const wchar_t* font[2];  // default fonts (main, small)
    bool shadow;
    int n;                 // number of lines used (max 5)
    CLine lines[5];
};

